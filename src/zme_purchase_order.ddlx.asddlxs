@Metadata.layer: #CUSTOMER

@UI: { presentationVariant: [{ sortOrder: [{ by: 'PurchaseOrder', direction:  #ASC }],
                               visualizations: [{ type: #AS_LINEITEM }],
                               text: 'Prod Yield Report' }] }
@UI: { headerInfo: { title: { type: #STANDARD, label: 'Purchase Order', value: 'PurchaseOrder' } } }
annotate entity ZC_PURCHASE_ORDER with
{
  @UI.facet:
    [{ id: 'GeneralData', isSummary: true, label: 'Purchase Order', type: #COLLECTION },
     { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 10, label: 'Section 1', id: 'GeneralData1' },
     { id: 'Item', label: 'Purchase Order Item', type: #LINEITEM_REFERENCE, position : 25, targetElement: '_Item' } ]

  @UI: { lineItem: [{ position: 10 },
        { type: #FOR_ACTION,
          dataAction: 'Print',
          label: 'Print',
          invocationGrouping: #ISOLATED }],
         identification: [{ position: 10 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }],
         selectionField: [{ position: 10 }] }
  PurchaseOrder;
  @UI: { lineItem: [{ position: 20 }],
         identification: [{ position: 20 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 20, importance: #HIGH }],
         selectionField: [{ position: 10 }] }
  PurchaseOrderDate;
  @UI: { lineItem: [{ position: 30 }],
         identification: [{ position: 30 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 30, importance: #HIGH }] }
  CreatedByUser;
  @UI: { lineItem: [{ position: 40 }],
         identification: [{ position: 40 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }] }
  CreationDate;
  @UI: { lineItem: [{ position: 50 }],
         identification: [{ position: 50 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 50, importance: #HIGH }] }
  PurchaseOrderType;
  @UI: { lineItem: [{ position: 60 }],
         identification: [{ position: 60 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 60, importance: #HIGH }] }
  PurchasingGroup;
  @UI: { lineItem: [{ position: 70 }],
         identification: [{ position: 70 }],
         fieldGroup: [{ qualifier: 'GeneralData1', position: 70, importance: #HIGH }] }
  PurchasingOrganization;

  @UI.hidden: true
  @UI.lineItem: [{ position: 80, label: 'Form URL', type: #WITH_URL, url:'FormURL' }]
  @UI.identification: [{ position: 80, label: 'Form URL', type: #WITH_URL, url: 'FormURL' }]
  FormURL;

  @UI.lineItem: [{position: 90,type: #WITH_URL, url: 'FormURL' }]
  @UI.identification: [{ position: 90, type: #WITH_URL, url: 'FormURL' }]
  Form;

}